{
  "id": "python",
  "name": "Python",
  "description": "Python interpreter with pip",
  "version": "0.0.0",
  "languages": [
    "python"
  ],
  "exec": "bin/python3",
  "env": {
    "PYTHONHOME": "{tool}",
    "PYTHONUSERBASE": "{data}/tools/pyuser",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PIP_USER": "1",
    "PIP_BREAK_SYSTEM_PACKAGES": "1",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PIP_CACHE_DIR": "{tmp}/pip-cache",
    "SSL_CERT_FILE": "{tool}/cert.pem"
  },
  "commands": [
    {
      "label": "pip install…",
      "args": [
        "-m",
        "pip",
        "install",
        "{?Package name}"
      ]
    },
    {
      "label": "pip install -r requirements.txt",
      "args": [
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ]
    },
    {
      "label": "pip uninstall…",
      "args": [
        "-m",
        "pip",
        "uninstall",
        "-y",
        "{?Package name}"
      ]
    },
    {
      "label": "pip list",
      "args": [
        "-m",
        "pip",
        "list"
      ]
    },
    {
      "label": "pip show…",
      "args": [
        "-m",
        "pip",
        "show",
        "{?Package name}"
      ]
    },
    {
      "label": "pip freeze",
      "args": [
        "-m",
        "pip",
        "freeze"
      ]
    },
    {
      "label": "pip install --upgrade pip",
      "args": [
        "-m",
        "pip",
        "install",
        "--upgrade",
        "pip"
      ]
    },
    {
      "label": "run…",
      "args": [
        "{?Script file}"
      ]
    },
    {
      "label": "--version",
      "args": [
        "--version"
      ]
    }
  ]
}
