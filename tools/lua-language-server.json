{
  "id": "lua-language-server",
  "name": "Lua Language Server",
  "description": "Lua language server",
  "version": "0.0.0",
  "languages": [
    "lua"
  ],
  "exec": "bin/lua-language-server",
  "lsp": {
    "args": [
      "-E",
      "{tool}/main.lua",
      "--logpath={tool}/log",
      "--metapath={tool}/meta"
    ],
    "cwd": "{tool}/bin/run"
  }
}
