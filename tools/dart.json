{
  "id": "dart",
  "name": "Dart SDK",
  "description": "Dart SDK: language server, formatter and pub",
  "version": "0.0.0",
  "languages": [
    "dart"
  ],
  "exec": "bin/dart",
  "env": {
    "PUB_CACHE": "{data}/tools/pub-cache",
    "DART_SUPPRESS_ANALYTICS": "true"
  },
  "lsp": {
    "args": [
      "language-server",
      "--protocol=lsp",
      "--sdk={tool}"
    ]
  },
  "format": {
    "mode": "stdio",
    "args": [
      "format",
      "--stdin-name={path}"
    ]
  }
}
