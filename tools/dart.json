{
  "id": "dart",
  "name": "Dart SDK",
  "description": "Dart SDK: language server, formatter and pub",
  "version": "0.0.0",
  "languages": [
    "dart"
  ],
  "exec": "bin/dart",
  "env": {
    "PUB_CACHE": "{data}/tools/pub-cache",
    "DART_SUPPRESS_ANALYTICS": "true"
  },
  "lsp": {
    "args": [
      "language-server",
      "--protocol=lsp",
      "--sdk={tool}"
    ]
  },
  "format": {
    "mode": "stdio",
    "args": [
      "format",
      "--stdin-name={path}"
    ]
  },
  "commands": [
    {
      "label": "pub get",
      "args": [
        "pub",
        "get"
      ]
    },
    {
      "label": "pub upgrade",
      "args": [
        "pub",
        "upgrade"
      ]
    },
    {
      "label": "pub outdated",
      "args": [
        "pub",
        "outdated"
      ]
    },
    {
      "label": "pub deps",
      "args": [
        "pub",
        "deps"
      ]
    },
    {
      "label": "analyze",
      "args": [
        "analyze"
      ]
    },
    {
      "label": "fix --apply",
      "args": [
        "fix",
        "--apply"
      ]
    },
    {
      "label": "format .",
      "args": [
        "format",
        "."
      ]
    },
    {
      "label": "--version",
      "args": [
        "--version"
      ]
    }
  ]
}
